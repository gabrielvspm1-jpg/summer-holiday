rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null && request.auth.token.email != null; }
    // Dono: coloque aqui o(s) e-mail(s) do dono, sempre em minúsculas.
    function dono() { return logado() && request.auth.token.email.lower() in ['gabrielvspm1@gmail.com']; }
    function acessoPath() { return /databases/$(database)/documents/acessos/$(request.auth.token.email.lower()); }
    function ehGarcom() { return logado() && exists(acessoPath()); }
    function ehOp() { return ehGarcom() && get(acessoPath()).data.get('op', false) == true; }
    function meuGarcomId() { return get(acessoPath()).data.garcomId; }

    // O dono lê e grava tudo.
    match /{document=**} {
      allow read, write: if dono();
    }

    // Cada garçom lê só o próprio cadastro de acesso.
    match /acessos/{email} {
      allow get: if logado() && request.auth.token.email.lower() == email;
    }

    // Cardápio (nomes e preços): o garçom pode ler.
    match /menu/{id} {
      allow read: if ehGarcom();
    }

    // Mesas: garçom comum lê só as dele; acesso de caixa lê e grava todas.
    match /mesas/{id} {
      allow read: if ehGarcom() && (ehOp() || resource.data.garcomId == meuGarcomId());
      allow write: if ehOp();
    }
    // Acesso de caixa: estoque, cadastros (leitura) e registro de cancelamentos.
    match /estoque/{id} {
      allow read, write: if ehOp();
    }
    // Só nomes de garçons e taxistas (sem comissões nem porcentagens).
    match /config/equipe {
      allow read: if ehOp();
    }
    match /log/{id} {
      allow read, write: if ehOp();
    }

    // Registro de atividades: qualquer conta liberada escreve (só com o próprio e-mail); só o dono lê.
    match /auditoria/{id} {
      allow create: if ehGarcom() && request.resource.data.email == request.auth.token.email.lower();
    }

    // Resumo dos dias fechados: só o do próprio garçom.
    match /ganhos/{id} {
      allow read: if ehGarcom() && resource.data.garcomId == meuGarcomId();
    }
  }
}
