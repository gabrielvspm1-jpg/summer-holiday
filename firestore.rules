rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Só o e-mail do dono lê e grava. Troque pelo seu e-mail se for outro.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'gabrielvspm1@gmail.com';
    }
  }
}
